<idea-plugin>
	<id>Dejavu Language</id>
	<name>Dejavu Language Support</name>
	<vendor>Dejavu Language</vendor>
	<depends>com.intellij.modules.platform</depends>
	<depends optional="true" config-file="plugin-with-rust.xml">org.rust.lang</depends>
	<resource-bundle>messages.DejavuBundle</resource-bundle>
	<extensions defaultExtensionNs="com.intellij">
		<fileType
			name="Dejavu"
			language="Dejavu"
			extensions="dj;dejavu;"
			implementationClass="dejavu.intellij.language.file.DejavuFileType"
			fieldName="INSTANCE"/>
		<fileType
			name="Doki"
			language="Doki"
			extensions="doki;"
			implementationClass="dejavu.intellij.language.file.DokiFileType"
			fieldName="INSTANCE"/>
		<lang.parserDefinition
			language="Dejavu"
			implementationClass="dejavu.intellij.language.parser.DejavuParserDefinition"/>
		<lang.parserDefinition
			language="Doki"
			implementationClass="dejavu.intellij.language.parser.DokiParserDefinition"/>
		<!-- Highlighter -->
		<colorSettingsPage implementation="dejavu.intellij.ide.highlight.DejavuHighlightSettingPage"/>
		<lang.syntaxHighlighter
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.highlight.DejavuSyntaxHighlighter"/>
		<lang.syntaxHighlighter
			language="Doki"
			implementationClass="dejavu.intellij.ide.highlight.DokiSyntaxHighlighter"/>
		<highlightVisitor implementation="dejavu.intellij.ide.highlight.DejavuSemanticHighlighter"/>
		<additionalTextAttributes scheme="Default" file="colors/VomlDefault.xml"/>
		<additionalTextAttributes scheme="Darcula" file="colors/VomlDarcula.xml"/>
		<!-- Formatter -->
		<langCodeStyleSettingsProvider
			implementation="dejavu.intellij.ide.codeStyle.LanguageCodeStyleSettingsProvider"
		/>
		<lang.commenter
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.VomlCommenter"
		/>
		<lang.braceMatcher
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.braces.VomlBraceMatcher"
		/>
		<lang.quoteHandler
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.YggQuoteHandler"
		/>
		<!-- Structure View -->
		<lang.foldingBuilder
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.folding.DejavuFoldingBuilder"
		/>
		<indexPatternBuilder
			implementation="dejavu.intellij.ide.todo.VomlTodoIndexPatternBuilder"
		/>
		<todoIndexer
			filetype="Dejavu"
			implementationClass="dejavu.intellij.ide.todo.VomlTodoIndexer"
		/>
		<typedHandler implementation="dejavu.intellij.ide.completion.CompletionTrigger"/>
		<completion.contributor
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.completion.CompletionContributor"
		/>
		<annotator
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.annotator.VomlHighlightingAnnotator"
		/>
		<annotator
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.annotator.checkers.YggScopeCheckerAnnotator"
		/>
		<annotator
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.annotator.checkers.YggTableCheckerAnnotator"
		/>

		<lang.formatter
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.formatter.FormatModel"/>
		<lang.smartEnterProcessor
			language="Dejavu"
			implementationClass="dejavu.intellij.ide.assist.fixers.SmartEnterProcessor"/>
	</extensions>
	<actions>
		<action
			id="djv.intellij.ide.actions.CreateDejavuFile"
			class="dejavu.intellij.ide.actions.CreateDejavuFile"
			text="Dejavu File"
			description="Create new Dejavu file">
			<add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFile"/>
		</action>
	</actions>
</idea-plugin>
